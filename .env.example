# URL base del backend (FastAPI) que consume el frontend.
# En local el backend corre en http://localhost:3001 y expone /api/v1.
# Copia este archivo como `.env.local` y ajusta si tu backend usa otra URL.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Token temporal de la demostración para las vistas internas del asesor.
# Token firmado emitido localmente con `python -m app.cli issue-token`.
# Solo se usa en esta demostración frontend; no es una estrategia productiva.
NEXT_PUBLIC_ADVISOR_ACCESS_TOKEN=paste-a-signed-local-demo-token

# Origen público usado para canonical, sitemap y datos estructurados.
# En local puede ser http://localhost:3000; en despliegue debe ser el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token real emitido por Google Search Console. Déjalo vacío si no se ha verificado.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
